# Copy to .env for local development. In production set these as real
# environment variables on the hosting platform - no .env file is needed.

# --- Telegram (required) ----------------------------------------------------
# Token issued by @BotFather.
BOT_TOKEN=123456:replace-me
# Standard cloud Bot API by default. Point this at the self-hosted local
# Bot API server to lift the 20 MB download / 50 MB upload limits - but only
# after the one-time logOut (python -m scripts.cutover_local_bot_api).
BOT_API_BASE_URL=https://api.telegram.org
# Local mode only: the Bot API server's private file endpoint, used when the
# bot runs in a different container than the server (Railway, compose).
# BOT_API_FILES_URL=http://telegram-bot-api.railway.internal:8082
# The server's --dir; only change it if the server uses a different one.
# BOT_API_LOCAL_DIR=/var/lib/telegram-bot-api

# --- Database ---------------------------------------------------------------
# PRODUCTION: set this to your PostgreSQL instance.
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/atreox
#
# A managed platform's own URL can be pasted in as-is: postgres:// and
# postgresql:// are rewritten to postgresql+asyncpg:// on startup, and an
# ?sslmode= parameter is translated to the ?ssl= spelling asyncpg expects.
#
# LOCAL DEVELOPMENT: leave DATABASE_URL unset and the bot falls back to a
# SQLite file (sqlite+aiosqlite:///./atreox_tools.db), needing no server.

# --- Runtime ----------------------------------------------------------------
LOG_LEVEL=INFO
# Service safety limits. While on the cloud Bot API, Telegram's own 20 MB /
# 50 MB ceilings still apply whatever is set here.
MAX_INPUT_FILE_SIZE_MB=2000
MAX_OUTPUT_FILE_SIZE_MB=1950
# Per native-tool run (one probe, one exiftool pass, one circle segment).
PROCESS_TIMEOUT_SECONDS=600
# Large-file jobs allowed at once; small files never wait on this.
MAX_CONCURRENT_MEDIA_JOBS=2
# Total disk the job workspaces may reserve; 0 = use the free space under
# TEMP_ROOT (always keeping a 512 MB margin).
TEMP_DISK_BUDGET_MB=0
# Root of the per-job temp workspaces. Each job gets its own subdirectory,
# removed when the job ends, so this never needs a persistent disk.
# Defaults to the OS temp directory when unset; the image sets /tmp/atreox-tools.
# TEMP_ROOT=/tmp/atreox-tools

# --- Native tools -----------------------------------------------------------
# Only needed if the binaries are not on PATH. The Docker image installs them.
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
EXIFTOOL_BIN=exiftool

# --- Feature tuning ---------------------------------------------------------
STICKERS_PER_BATCH=6
VIDEO_NOTE_MAX_DURATION=60
VIDEO_NOTE_SIZE=384

# Comma separated Telegram user ids allowed to run /stats.
ADMIN_USER_IDS=
