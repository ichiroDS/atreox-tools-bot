# Copy to .env for local development. In production set these as real
# environment variables on the hosting platform - no .env file is needed.

# --- Telegram (required) ----------------------------------------------------
# Token issued by @BotFather.
BOT_TOKEN=123456:replace-me
# Standard cloud Bot API by default. Point this at a self-hosted local
# Bot API server (e.g. http://bot-api:8081) to lift the 20MB download limit.
BOT_API_BASE_URL=https://api.telegram.org

# --- Database ---------------------------------------------------------------
# PRODUCTION: set this to your PostgreSQL instance. The +asyncpg driver is
# required; a plain postgresql:// URL will not work.
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/atreox
#
# LOCAL DEVELOPMENT: leave DATABASE_URL unset and the bot falls back to a
# SQLite file (sqlite+aiosqlite:///./atreox_tools.db), needing no server.

# --- Runtime ----------------------------------------------------------------
LOG_LEVEL=INFO
MAX_FILE_SIZE_MB=20
PROCESS_TIMEOUT_SECONDS=120
# Root of the per-job temp workspaces. Each job gets its own subdirectory,
# removed when the job ends, so this never needs a persistent disk.
# Defaults to the OS temp directory when unset; the image sets /tmp/atreox-tools.
# TEMP_ROOT=/tmp/atreox-tools

# --- Native tools -----------------------------------------------------------
# Only needed if the binaries are not on PATH. The Docker image installs them.
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
EXIFTOOL_BIN=exiftool

# --- Feature tuning ---------------------------------------------------------
STICKERS_PER_BATCH=6
VIDEO_NOTE_MAX_DURATION=60
VIDEO_NOTE_SIZE=384

# Comma separated Telegram user ids allowed to run /stats.
ADMIN_USER_IDS=
